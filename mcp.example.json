{
  "servers": {
    "time": {
      "command": "uvx",
      "args": [
        "mcp-server-time"
      ],
      "trusted": true,
      "enabled": true
    },
    "files": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "data/sandbox"
      ],
      "trusted": false,
      "enabled": true
    },
    "web": {
      "command": "npx",
      "args": [
        "-y",
        "tavily-mcp@latest"
      ],
      "env": {
        "TAVILY_API_KEY": "${TAVILY_API_KEY}"
      },
      "read_only": [
        "tavily_search",
        "tavily_extract"
      ],
      "trusted": true,
      "enabled": false
    }
  }
}
