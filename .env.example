# 복사해서 .env로 만들고 값을 채운다. .env는 git에 올리지 않는다.
# 코드에는 기본값만 있고, 실제 조절은 여기서 한다. 지우거나 비워 두면 기본값을 쓴다.

# 제공자 선택: openai 또는 anthropic (기본: openai)
LLM_PROVIDER=openai

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# 응답의 출력 토큰 상한(추론 토큰 포함). 없으면 API 기본값. 너무 작으면 답이 잘린다.
# OPENAI_MAX_OUTPUT_TOKENS=

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_MAX_TOKENS=16000

# --- Agent Loop ---
# 한 턴(질문 하나)에서 모델을 호출하는 최대 횟수(스텝 상한). 기본: 10
AGENT_MAX_STEPS=10

# 응답 출력 방식(examples/chat.py가 읽는다). 기본: true
#   true  : 스트리밍. 모델이 쓰는 대로 글자를 바로 출력한다.
#   false : 일괄 응답. 답이 완성된 뒤 한 번에 출력한다.
# 허용 값: true, false, 1, 0 (대소문자 무시). 실행 인자 --stream / --no-stream이 이 값보다 우선한다.
AGENT_STREAM=true

# --- Tool / MCP (examples/chat.py가 읽는다) ---
# 연결할 MCP 서버 목록이 든 JSON 파일 경로. 비워 두면 MCP를 쓰지 않고 내장 Tool만 쓴다.
# 사용법: mcp.example.json을 mcp.json으로 복사해 고친 뒤 아래 줄의 주석을 푼다. 실행 인자 --mcp-config가 이 값보다 우선한다.
# 주의: stdio 서버는 내 계정 권한으로 실행되는 프로그램이다. 신뢰하는 서버만 적는다. mcp.json은 git에 올리지 않는다.
MCP_CONFIG=mcp.json
# MCP_TOOL_TIMEOUT: MCP Tool 한 번 호출의 제한 시간(초). 넘으면 오류로 모델에 알린다. 기본: 30
MCP_TOOL_TIMEOUT=30
# MCP_START_TIMEOUT: MCP 서버를 띄우고 Tool 목록을 받기까지의 제한 시간(초). 처음 실행은 패키지를 내려받아 오래 걸릴 수 있다. 기본: 60
MCP_START_TIMEOUT=60
# TOOL_RESULT_MAX_CHARS: Tool 결과(내장·MCP 공통)의 최대 글자 수. 넘으면 앞부분만 남기고 잘렸다는 안내를 붙인다. 기본: 20000
TOOL_RESULT_MAX_CHARS=20000

# 추적 기록: 턴, 스텝, LLM 호출, Tool 실행을 logs/sessions/ 아래 세션별 파일에 남긴다. false면 남기지 않는다.
TRACE_ENABLED=true

# 컨텍스트와 메모리(C9)
# 이력 크기(다음 호출에 보낼 토큰 수)가 이 값을 넘으면 /compact를 안내한다. 자동으로 줄이지는 않는다.
COMPACT_WARN_TOKENS=100000
# /compact를 해도 원문으로 남길 최근 턴 수
COMPACT_KEEP_TURNS=4
# 컴팩션 요약에 쓸 제공자와 모델. 비워 두면 대화 모델과 같은 값을 쓴다.
COMPACT_LLM_PROVIDER=
COMPACT_LLM_MODEL=
# 장기 메모리(data/memory.md)가 이 토큰 수를 넘으면 /memory에서 경고한다
MEMORY_WARN_TOKENS=2000

# 워크플로(C10)
# 출처 검사 실패와 사람의 다르게 요청을 합쳐 고쳐 쓰기를 이만큼까지 한다. 넘으면 "근거를 찾지 못했다"로 끝낸다.
WORKFLOW_MAX_REVISIONS=2
# LangGraph와 함께 설치되는 langsmith의 외부 추적. true로 바꾸지 않으면 외부로 보내지 않는다(C12 전까지 끈다).
LANGSMITH_TRACING=false

# --- Safety (C11): 항상 켜진 고정 검사 ---
# 외부 내용 감싸기, 지시문 탐지, 키와 개인정보 가리기는 항상 켜져 있고 끄는 설정은 없다.
# 안전 정책 파일: Tool을 막거나(deny) 승인을 받게 하거나(ask) 경로를 제한한다. 더 엄격하게만 바꿀 수 있다.
# 사용법: safety.example.json을 safety.json으로 복사해 고친다. 파일이 없으면 경고를 보이고 안전 정책 없이 시작한다. 비워 두면 안전 정책을 쓰지 않는다.
SAFETY_CONFIG=safety.json

# --- Hook (C11): 사용자가 설치하는 확장 ---
# Tool 실행 전후와 답 직전에 외부 명령을 실행한다(before_tool, after_tool, after_answer). 형식은 hooks.example.json 참고.
# 사용법: hooks.example.json을 hooks.json으로 복사해 고친다. 파일이 없으면 경고를 보이고 Hook 없이 시작한다. 명령은 hooks.json이 있는 폴더에서 실행한다.
HOOKS_CONFIG=hooks.json
# HOOK_TIMEOUT: Hook 명령 한 번의 제한 시간(초). 넘기면 before_tool은 막고, 나머지는 값을 그대로 둔다. 기본: 10
HOOK_TIMEOUT=10
