# 복사해서 .env로 만들고 값을 채운다. .env는 git에 올리지 않는다.
# 코드에는 기본값만 있고, 실제 조절은 여기서 한다. 지우거나 비워 두면 기본값을 쓴다.

# 제공자 선택: openai 또는 anthropic (기본: openai)
LLM_PROVIDER=openai

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# 응답의 출력 토큰 상한(추론 토큰 포함). 없으면 API 기본값. 너무 작으면 답이 잘린다.
# OPENAI_MAX_OUTPUT_TOKENS=

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_MAX_TOKENS=16000

# --- Agent Loop ---
# 한 턴(질문 하나)에서 모델을 호출하는 최대 횟수(스텝 상한). 기본: 10
AGENT_MAX_STEPS=10

# 응답 출력 방식(examples/chat.py가 읽는다). 기본: true
#   true  : 스트리밍. 모델이 쓰는 대로 글자를 바로 출력한다.
#   false : 일괄 응답. 답이 완성된 뒤 한 번에 출력한다.
# 허용 값: true, false, 1, 0 (대소문자 무시). 실행 인자 --stream / --no-stream이 이 값보다 우선한다.
AGENT_STREAM=true

# --- Tool / MCP (examples/chat.py가 읽는다) ---
# 연결할 MCP 서버 목록이 든 JSON 파일 경로. 비워 두면 MCP를 쓰지 않고 내장 Tool만 쓴다.
# 사용법: mcp.example.json을 mcp.json으로 복사해 고친 뒤 아래 줄의 주석을 푼다. 실행 인자 --mcp-config가 이 값보다 우선한다.
# 주의: stdio 서버는 내 계정 권한으로 실행되는 프로그램이다. 신뢰하는 서버만 적는다. mcp.json은 git에 올리지 않는다.
# MCP_CONFIG=mcp.json
# MCP_TOOL_TIMEOUT: MCP Tool 한 번 호출의 제한 시간(초). 넘으면 오류로 모델에 알린다. 기본: 30
MCP_TOOL_TIMEOUT=30
# MCP_START_TIMEOUT: MCP 서버를 띄우고 Tool 목록을 받기까지의 제한 시간(초). 처음 실행은 패키지를 내려받아 오래 걸릴 수 있다. 기본: 60
MCP_START_TIMEOUT=60
# TOOL_RESULT_MAX_CHARS: Tool 결과(내장·MCP 공통)의 최대 글자 수. 넘으면 앞부분만 남기고 잘렸다는 안내를 붙인다. 기본: 20000
TOOL_RESULT_MAX_CHARS=20000

# 추적 기록: 턴, 스텝, LLM 호출, Tool 실행을 logs/sessions/ 아래 세션별 파일에 남긴다. false면 남기지 않는다.
TRACE_ENABLED=true
